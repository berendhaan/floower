# ESPHome secrets for Floower
# Copy this file to secrets.yaml and fill in your values.
# NEVER commit secrets.yaml to version control.

wifi_ssid: "YourWiFiSSID"
wifi_password: "YourWiFiPassword"

# Fallback access-point password (shown when WiFi is unreachable)
ap_password: "floower123"

# Home Assistant API encryption key
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
api_encryption_key: "REPLACE_WITH_32_BYTE_HEX_KEY"

# OTA update password
ota_password: "REPLACE_WITH_OTA_PASSWORD"
